<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<meta name="theme-color" content="#111111">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<title>Fece-gis | مدیریت فروشگاه</title>
<link rel="manifest" href="manifest.json">
<style>
:root{--bg:#101010;--panel:#1c1c1c;--gold:#d8b45a;--muted:#aaa;--line:#393329;--red:#ef7777}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#f7f2e7;font-family:Tahoma,Arial,sans-serif}header{padding:18px 14px;background:linear-gradient(135deg,#090909,#282116);border-bottom:1px solid var(--gold);position:sticky;top:0;z-index:3}h1{font-size:21px;margin:0;color:var(--gold)}header small{color:#d8d0bd}main{padding:12px;max-width:1000px;margin:auto}.brand{text-align:center}.crown{font-size:26px;color:var(--gold)}nav{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:12px 0}button,.tab{border:1px solid #6d5829;background:#24211b;color:#f7e5b2;border-radius:10px;padding:11px 8px;font:inherit;cursor:pointer}button.primary{background:var(--gold);color:#17130a;font-weight:bold}button.danger{border-color:#844747;color:#ffb6b6}.page{display:none}.page.active{display:block}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.card,.box{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:13px;margin-bottom:10px}.metric{font-size:21px;color:var(--gold);font-weight:bold;margin-top:7px}.muted{color:var(--muted);font-size:12px}label{display:block;margin:10px 0 5px;color:#e4d4a8}input,select,textarea{width:100%;padding:11px;background:#101010;color:white;border:1px solid #51452d;border-radius:8px;font:inherit}form .row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}.actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.actions button{padding:8px;font-size:12px}.item{border-bottom:1px solid #38322a;padding:10px 0}.item:last-child{border:0}.item strong{color:#f0d58c}.pill{font-size:11px;border-radius:20px;padding:4px 8px;background:#3b3020;color:#f4d98c}.warn{color:#ff9c9c}.total{font-size:18px;color:var(--gold);font-weight:bold}.hidden{display:none!important}.notice{padding:10px;background:#282316;border-radius:8px;color:#e8d49d;font-size:12px;margin:8px 0}footer{text-align:center;color:#777;padding:20px;font-size:11px}@media(min-width:700px){.cards{grid-template-columns:repeat(4,1fr)}nav{grid-template-columns:repeat(7,1fr)}}
</style>
</head>
<body>
<header><div class="brand"><div class="crown">♛</div><h1>Fece-gis</h1><small>مدیریت هوشمند فروشگاه لوازم مو و آرایشی</small></div></header>
<main>
<div class="notice">اطلاعات ابتدا روی همین دستگاه ذخیره می‌شود. از بخش «پشتیبان» تنظیمات Supabase را وارد کنید تا همگام‌سازی بین گوشی و لپ‌تاپ فعال شود.</div>
<nav>
<button onclick="show('home')">داشبورد</button><button onclick="show('products')">کالاها</button><button onclick="show('sale')">ثبت فروش</button><button onclick="show('invoices')">فاکتورها</button><button onclick="show('reports')">گزارش‌ها</button><button onclick="show('customers')">مشتریان</button><button onclick="show('backup')">پشتیبان</button>
</nav>
<section id="home" class="page active">
<div class="cards">
<div class="card">فروش امروز<div class="metric" id="todaySales">۰ تومان</div></div>
<div class="card">سود امروز<div class="metric" id="todayProfit">۰ تومان</div></div>
<div class="card">تعداد کالاها<div class="metric" id="productCount">۰</div></div>
<div class="card">فاکتورهای امروز<div class="metric" id="invoiceCount">۰</div></div>
</div>
<div class="box"><h3>هشدار کمبود موجودی</h3><div id="lowStock"></div></div>
<div class="box"><h3>جست‌وجوی سریع کالا</h3><input id="homeSearch" placeholder="نام کالا یا بارکد..." oninput="renderHomeSearch()"><div id="homeResults"></div></div>
</section>
<section id="products" class="page">
<div class="box"><h3 id="productFormTitle">ثبت کالای جدید</h3><form id="productForm">
<input type="hidden" id="editId">
<label>نام کالا</label><input id="pName" required placeholder="مثلاً ماسک ورقه‌ای">
<div class="row"><div><label>دسته‌بندی</label><input id="pCat" placeholder="ماسک، مو، آرایشی"></div><div><label>بارکد (خالی بماند خودکار ساخته می‌شود)</label><input id="pBarcode" inputmode="numeric"></div></div>
<div class="row"><div><label>قیمت خرید (تومان)</label><input id="pBuy" type="number" min="0" required></div><div><label>قیمت فروش اصلی (تومان)</label><input id="pSell" type="number" min="0" required></div></div>
<div class="box"><label>تخفیف این کالا (درصد)</label><input id="pDiscount" type="number" min="0" max="100" value="0" placeholder="مثلاً ۱۵ برای ۱۵٪ تخفیف"><small class="muted">برای کالایی که تخفیف ندارد، عدد ۰ بماند.</small></div>
<div class="row"><div><label>موجودی</label><input id="pQty" type="number" min="0" value="0" required></div><div><label>هشدار در موجودی کمتر از</label><input id="pMin" type="number" min="0" value="5"></div></div>
<div class="actions"><button class="primary" type="submit">ذخیره کالا</button><button type="button" onclick="resetProductForm()">پاک‌کردن فرم</button></div>
</form></div>
<div class="box"><h3>فهرست کالاها</h3><input id="productSearch" placeholder="جست‌وجوی نام یا بارکد..." oninput="renderProducts()"><div id="productList"></div></div>
<div class="box"><h3>ورود اطلاعات از دفتر</h3><p class="muted">فعلاً می‌توانید عکس دفتر را انتخاب کنید تا برای بررسی نگه دارید؛ خواندن خودکار دست‌خط و ثبت گروهی در این نسخه هنوز فعال نیست. اطلاعات را می‌توانید با فرم بالا وارد کنید.</p><input id="notebookPhoto" type="file" accept="image/*" capture="environment"><div id="photoStatus" class="muted"></div></div>
</section>
<section id="sale" class="page">
<div class="box"><h3>ثبت فروش جدید</h3>
<label>نام مشتری</label><input id="customerName" placeholder="نام مشتری">
<label>شماره تلفن مشتری</label><input id="customerPhone" type="tel" placeholder="09...">
<label>جست‌وجوی کالا یا بارکد</label><input id="saleSearch" placeholder="نام کالا / بارکد..." oninput="renderSaleSearch()"><div id="saleResults"></div>
<h4>اقلام فاکتور</h4><div id="cartList"></div>
<div class="total">جمع کل: <span id="cartTotal">۰ تومان</span></div>
<div class="actions"><button class="primary" onclick="finishSale()">ثبت نهایی فروش</button><button onclick="clearCart()">خالی کردن فاکتور</button></div>
</div>
</section>
<section id="invoices" class="page"><div class="box"><h3>همه فاکتورها</h3><div id="invoiceList"></div></div></section>
<section id="reports" class="page"><div class="box"><h3>گزارش فروش</h3><div id="reportSummary"></div><div id="reportList"></div></div></section>
<section id="customers" class="page"><div class="box"><h3>مشتریان ذخیره‌شده</h3><p class="muted">نام و شماره مشتری هنگام ثبت فروش ذخیره می‌شود.</p><input id="customerSearch" placeholder="جست‌وجوی نام یا شماره" oninput="renderCustomers()"><div id="customerList"></div></div><div class="box"><h3>ارسال پیام دلخواه</h3><label>انتخاب مشتری</label><select id="messageCustomer"><option value="">انتخاب مشتری</option></select><label>متن پیام</label><textarea id="customMessage" rows="5" placeholder="متن دلخواه پیام را بنویسید..."></textarea><div class="actions"><button class="primary" onclick="sendCustomMessage('whatsapp')">ارسال با واتساپ</button><button onclick="sendCustomMessage('sms')">ارسال پیامک</button></div></div></section>
<section id="backup" class="page"><div class="box" style="border:2px solid #d6ad52;box-shadow:0 0 16px #d6ad5222"><h3 style="color:#f1cb68">همگام‌سازی آنلاین گوشی و لپ‌تاپ</h3><p class="muted">اول کلید عمومی را در کادر زیر وارد کن. فقط کلید Publishable مجاز است؛ کلید Secret را وارد نکن.</p><label>آدرس پروژه Supabase (آماده است)</label><input id="sbUrl" type="url" value="https://dkgjkgkakcadzmtslopt.supabase.co" placeholder="https://xxxxx.supabase.co"><label style="color:#f1cb68;font-weight:bold">کلید عمومی Publishable را اینجا وارد کن</label><input id="sbKey" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" value="" placeholder="sb_publishable_..." style="border:2px solid #d6ad52;font-size:16px"><button class="primary" style="width:100%;margin-top:10px" onclick="saveCloudSettings()">ذخیره کلید و تنظیمات</button><div id="cloudStatus" class="notice">ابتدا کلید عمومی را وارد و ذخیره کن.</div><hr style="border-color:#393329"><h3>ورود به حساب همگام‌سازی</h3><p class="muted">در همه دستگاه‌ها از همان ایمیل و رمز استفاده کن.</p><div class="row"><div><label>ایمیل حساب</label><input id="sbEmail" type="email" autocomplete="username" placeholder="ایمیل حساب Supabase"></div><div><label>رمز حساب</label><input id="sbPassword" type="password" autocomplete="current-password" placeholder="رمز حساب Supabase"></div></div><div class="actions"><button class="primary" onclick="cloudSignUp()">ساخت حساب</button><button onclick="cloudSignIn()">ورود و همگام‌سازی</button><button onclick="cloudSyncNow()">همگام‌سازی اکنون</button><button class="danger" onclick="cloudSignOut()">خروج از حساب</button></div><hr style="border-color:#393329"><h3>پشتیبان‌گیری و بازیابی</h3><p>برای نگهداری اطلاعات یا انتقال دستی، فایل پشتیبان بگیر.</p><div class="actions"><button class="primary" onclick="exportData()">دانلود پشتیبان</button><label style="margin:0"><input type="file" id="importFile" accept=".json,application/json" onchange="importData(event)"></label></div><hr style="border-color:#393329"><h3>قفل عددی</h3><p class="muted">این قفل ساده برای استفاده روزمره است و جایگزین ورود امن چندکاربره نیست.</p><input id="newPin" inputmode="numeric" maxlength="8" placeholder="رمز عددی جدید"><button onclick="setPin()">ذخیره رمز</button><button class="danger" onclick="clearAll()">حذف همه اطلاعات</button></div></section>
<footer>Fece-gis • نسخه اولیه قابل آزمایش • مشکی و طلایی</footer>
</main>
<script>
const fa=n=>Number(n||0).toLocaleString('fa-IR');
const money=n=>fa(n)+' تومان';
const get=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))??d}catch{return d}};
let products=get('fg_products',[]), invoices=get('fg_invoices',[]), customers=get('fg_customers',[]), cart=[];
function save(){localStorage.setItem('fg_products',JSON.stringify(products));localStorage.setItem('fg_invoices',JSON.stringify(invoices));localStorage.setItem('fg_customers',JSON.stringify(customers));localStorage.setItem('fg_local_updated',String(Date.now()));renderAll();if(typeof cloudAutoSync==='function'&&navigator.onLine)setTimeout(cloudAutoSync,700)}
function show(id){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');renderAll();window.scrollTo(0,0)}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,6)}
function resetProductForm(){productForm.reset();editId.value='';pQty.value=0;pMin.value=5;pDiscount.value=0;productFormTitle.textContent='ثبت کالای جدید'}
productForm.addEventListener('submit',e=>{e.preventDefault();let id=editId.value;let old=products.find(p=>p.id===id);let discount=Math.max(0,Math.min(100,+pDiscount.value||0));let p={id:id||uid(),name:pName.value.trim(),cat:pCat.value.trim(),barcode:pBarcode.value.trim()||('FG'+Date.now().toString().slice(-8)),buy:+pBuy.value,sell:+pSell.value,discount,qty:+pQty.value,min:+pMin.value};if(old){products=products.map(x=>x.id===id?p:x)}else products.push(p);save();resetProductForm();alert('کالا ذخیره شد')});
function editProduct(id){let p=products.find(x=>x.id===id);if(!p)return;editId.value=p.id;pName.value=p.name;pCat.value=p.cat;pBarcode.value=p.barcode;pBuy.value=p.buy;pSell.value=p.sell;pQty.value=p.qty;pMin.value=p.min;pDiscount.value=p.discount||0;productFormTitle.textContent='ویرایش کالا';show('products')}
function deleteProduct(id){if(confirm('این کالا حذف شود؟')){products=products.filter(p=>p.id!==id);save()}}
function renderProducts(){let q=(productSearch.value||'').toLowerCase();productList.innerHTML=products.filter(p=>(p.name+' '+p.barcode+' '+p.cat).toLowerCase().includes(q)).map(p=>`<div class="item"><strong>${esc(p.name)}</strong> <span class="pill">${esc(p.cat||'بدون دسته')}</span><div class="muted">بارکد: ${esc(p.barcode)} | خرید: ${money(p.buy)} | فروش اصلی: ${money(p.sell)}</div><div>قیمت نهایی: <strong>${money(Math.round(p.sell*(1-(p.discount||0)/100)))}</strong> ${p.discount?`<span class="pill">${fa(p.discount)}٪ تخفیف</span>`:' '}</div><div>موجودی: <b class="${p.qty<=p.min?'warn':''}">${fa(p.qty)}</b> | سود هر عدد: ${money(p.sell-p.buy)}</div><div class="actions"><button onclick="editProduct('${p.id}')">ویرایش</button><button onclick="printLabel('${p.id}')">چاپ برچسب</button><button class="danger" onclick="deleteProduct('${p.id}')">حذف</button></div></div>`).join('')||'<p class="muted">هنوز کالایی ثبت نشده است.</p>'}
function renderHomeSearch(){let q=(homeSearch.value||'').toLowerCase();homeResults.innerHTML=products.filter(p=>(p.name+' '+p.barcode).toLowerCase().includes(q)).slice(0,10).map(p=>`<div class="item">${esc(p.name)} — ${money(p.sell)} — موجودی ${fa(p.qty)}</div>`).join('')}
function renderSaleSearch(){let q=(saleSearch.value||'').toLowerCase();saleResults.innerHTML=products.filter(p=>(p.name+' '+p.barcode).toLowerCase().includes(q)&&q).slice(0,10).map(p=>`<div class="item"><strong>${esc(p.name)}</strong> — ${money(Math.round(p.sell*(1-(p.discount||0)/100)))} ${p.discount?`<span class="pill">${fa(p.discount)}٪ تخفیف</span>`:''} — موجودی ${fa(p.qty)} <button onclick="addCart('${p.id}')">افزودن</button></div>`).join('')}
function addCart(id){let p=products.find(x=>x.id===id);if(!p)return;let c=cart.find(x=>x.id===id);if(c){if(c.qty>=p.qty)return alert('موجودی کافی نیست');c.qty++}else{if(p.qty<1)return alert('موجودی این کالا تمام شده است');cart.push({id,qty:1})}renderCart()}
function changeCart(id,delta){let c=cart.find(x=>x.id===id),p=products.find(x=>x.id===id);if(!c)return;c.qty+=delta;if(c.qty<1)cart=cart.filter(x=>x.id!==id);if(c&&c.qty>p.qty){c.qty=p.qty;alert('بیشتر از موجودی نمی‌توان فروخت')}renderCart()}
function renderCart(){cartList.innerHTML=cart.map(c=>{let p=products.find(x=>x.id===c.id);if(!p)return '';let price=Math.round(p.sell*(1-(p.discount||0)/100));return p?`<div class="item">${esc(p.name)} ${p.discount?`<span class="pill">${fa(p.discount)}٪ تخفیف</span>`:''}<div>${money(price)} × ${fa(c.qty)} = <strong>${money(price*c.qty)}</strong></div><div class="actions"><button onclick="changeCart('${p.id}',-1)">−</button><button onclick="changeCart('${p.id}',1)">+</button></div></div>`:''}).join('')||'<p class="muted">هنوز کالایی به فاکتور اضافه نشده است.</p>';cartTotal.textContent=money(cart.reduce((s,c)=>{let p=products.find(x=>x.id===c.id);return s+(p?Math.round(p.sell*(1-(p.discount||0)/100))*c.qty:0)},0))}
function clearCart(){cart=[];renderCart()}
function finishSale(){if(!cart.length)return alert('ابتدا کالا انتخاب کنید');for(let c of cart){let p=products.find(x=>x.id===c.id);if(!p||p.qty<c.qty)return alert('موجودی یکی از کالاها کافی نیست')}let items=cart.map(c=>{let p=products.find(x=>x.id===c.id);let finalSell=Math.round(p.sell*(1-(p.discount||0)/100));return {id:p.id,name:p.name,barcode:p.barcode,qty:c.qty,buy:p.buy,sell:finalSell,originalSell:p.sell,discount:p.discount||0}});let inv={id:uid(),number:'FG-'+Date.now().toString().slice(-6),date:new Date().toISOString(),customer:customerName.value.trim(),phone:customerPhone.value.trim(),items,total:items.reduce((s,i)=>s+i.sell*i.qty,0),profit:items.reduce((s,i)=>s+(i.sell-i.buy)*i.qty,0),cancelled:false};if(inv.customer||inv.phone){let existing=customers.find(c=>(inv.phone&&c.phone===inv.phone)||(!inv.phone&&inv.customer&&c.name===inv.customer));if(existing){if(inv.customer)existing.name=inv.customer;if(inv.phone)existing.phone=inv.phone;existing.lastPurchase=inv.date;existing.purchases=(existing.purchases||0)+1}else customers.push({id:uid(),name:inv.customer||'مشتری بدون نام',phone:inv.phone,lastPurchase:inv.date,purchases:1})}items.forEach(i=>{let p=products.find(x=>x.id===i.id);p.qty-=i.qty});invoices.unshift(inv);cart=[];customerName.value='';customerPhone.value='';saleSearch.value='';save();renderCart();alert('فاکتور ثبت شد: '+inv.number);show('invoices')}
function cancelInvoice(id){let inv=invoices.find(x=>x.id===id);if(!inv||inv.cancelled)return;if(!confirm('فاکتور لغو شود و موجودی برگردد؟'))return;inv.items.forEach(i=>{let p=products.find(x=>x.id===i.id);if(p)p.qty+=i.qty});inv.cancelled=true;save()}
function invoiceHtml(inv){return `<div class="item"><strong>فاکتور ${esc(inv.number)}</strong> ${inv.cancelled?'<span class="pill">لغو شده</span>':''}<div class="muted">${new Date(inv.date).toLocaleString('fa-IR')} | مشتری: ${esc(inv.customer||'—')} | ${esc(inv.phone||'—')}</div><div>${inv.items.map(i=>`${esc(i.name)} × ${fa(i.qty)}`).join('، ')}</div><div>جمع: ${money(inv.total)} | سود: ${money(inv.profit)}</div><div class="actions"><button onclick="printInvoice('${inv.id}')">چاپ / ذخیره PDF</button><button onclick="sendCustomer('${inv.id}','whatsapp')">ارسال پیام واتساپ</button><button onclick="sendCustomer('${inv.id}','sms')">ارسال پیامک</button>${!inv.cancelled?`<button class="danger" onclick="cancelInvoice('${inv.id}')">لغو فاکتور</button>`:''}</div></div>`}
function sendCustomer(id,channel){let inv=invoices.find(x=>x.id===id);if(!inv)return;if(!inv.phone)return alert('شماره تلفن مشتری در فاکتور ثبت نشده است.');let lines=inv.items.map(i=>`• ${i.name} × ${i.qty}: ${money(i.sell*i.qty)}`).join('\n');let msg=`سلام ${inv.customer||'مشتری گرامی'} عزیز 🌷\nاز خرید شما از فروشگاه Fece-gis سپاسگزاریم.\nشماره فاکتور: ${inv.number}\n${lines}\nمبلغ فاکتور: ${money(inv.total)}\nتاریخ: ${new Date(inv.date).toLocaleDateString('fa-IR')}\nبا تشکر از خرید شما`;let phone=inv.phone.replace(/[^0-9+]/g,'');if(channel==='whatsapp'){let wa=phone.startsWith('0')?'98'+phone.slice(1):phone;window.open('https://wa.me/'+wa+'?text='+encodeURIComponent(msg),'_blank')}else{window.location.href='sms:'+phone+'?body='+encodeURIComponent(msg)}} 
function renderInvoices(){invoiceList.innerHTML=invoices.map(invoiceHtml).join('')||'<p class="muted">هنوز فاکتوری ثبت نشده است.</p>'}
function renderReports(){let active=invoices.filter(i=>!i.cancelled),sum=active.reduce((s,i)=>s+i.total,0),profit=active.reduce((s,i)=>s+i.profit,0);reportSummary.innerHTML=`<div class="cards"><div class="card">کل فروش ثبت‌شده<div class="metric">${money(sum)}</div></div><div class="card">سود کل<div class="metric">${money(profit)}</div></div></div>`;reportList.innerHTML=active.map(i=>`<div class="item">${esc(i.number)} — ${new Date(i.date).toLocaleDateString('fa-IR')} — ${money(i.total)} — سود ${money(i.profit)}</div>`).join('')||'<p class="muted">گزارشی وجود ندارد.</p>'}
function renderCustomers(){if(!document.getElementById('customerList'))return;let q=(customerSearch.value||'').trim().toLowerCase();let list=customers.filter(c=>(c.name+' '+(c.phone||'')).toLowerCase().includes(q));customerList.innerHTML=list.map(c=>`<div class="item"><strong>${esc(c.name||'بدون نام')}</strong><div class="muted">${esc(c.phone||'بدون شماره')} • تعداد خرید: ${fa(c.purchases||0)}</div><div class="actions"><button onclick="selectMessageCustomer('${c.id}')">ارسال پیام دلخواه</button></div></div>`).join('')||'<p class="muted">هنوز مشتری ذخیره نشده است.</p>';messageCustomer.innerHTML='<option value="">انتخاب مشتری</option>'+customers.map(c=>`<option value="${esc(c.id)}">${esc(c.name||'بدون نام')} — ${esc(c.phone||'بدون شماره')}</option>`).join('')}
function selectMessageCustomer(id){messageCustomer.value=id;document.getElementById('customMessage').focus()}
function sendCustomMessage(channel){let c=customers.find(x=>x.id===messageCustomer.value);if(!c)return alert('ابتدا مشتری را انتخاب کنید.');if(!c.phone)return alert('برای این مشتری شماره تلفن ذخیره نشده است.');let msg=customMessage.value.trim();if(!msg)return alert('متن پیام را بنویسید.');let phone=c.phone.replace(/[^0-9+]/g,'');if(channel==='whatsapp'){let wa=phone.startsWith('0')?'98'+phone.slice(1):phone;window.open('https://wa.me/'+wa+'?text='+encodeURIComponent(msg),'_blank')}else{window.location.href='sms:'+phone+'?body='+encodeURIComponent(msg)}}
function renderHome(){let today=new Date().toDateString(),tod=invoices.filter(i=>!i.cancelled&&new Date(i.date).toDateString()===today);todaySales.textContent=money(tod.reduce((s,i)=>s+i.total,0));todayProfit.textContent=money(tod.reduce((s,i)=>s+i.profit,0));productCount.textContent=fa(products.length);invoiceCount.textContent=fa(tod.length);lowStock.innerHTML=products.filter(p=>p.qty<=p.min).map(p=>`<div class="item warn">${esc(p.name)} — فقط ${fa(p.qty)} عدد (حد هشدار ${fa(p.min)})</div>`).join('')||'<p class="muted">هشدار کمبود موجودی ندارید.</p>';renderHomeSearch()}
function renderAll(){renderHome();renderProducts();renderSaleSearch();renderCart();renderInvoices();renderReports();renderCustomers()}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function printInvoice(id){let i=invoices.find(x=>x.id===id);if(!i)return;let w=window.open('','_blank');w.document.write(`<html lang="fa" dir="rtl"><meta charset="utf-8"><title>فاکتور ${esc(i.number)}</title><style>body{font-family:Tahoma;padding:20px}table{width:100%;border-collapse:collapse}td,th{border:1px solid #aaa;padding:8px;text-align:right}</style><h2>♛ Fece-gis</h2><h3>فاکتور ${esc(i.number)}</h3><p>مشتری: ${esc(i.customer||'—')} | تلفن: ${esc(i.phone||'—')}</p><p>تاریخ: ${new Date(i.date).toLocaleString('fa-IR')}</p><table><tr><th>کالا</th><th>تعداد</th><th>قیمت</th><th>جمع</th></tr>${i.items.map(x=>`<tr><td>${esc(x.name)}</td><td>${x.qty}</td><td>${x.sell.toLocaleString('fa-IR')}${x.discount?` (تخفیف ${x.discount}٪)`:""}</td><td>${(x.qty*x.sell).toLocaleString('fa-IR')}</td></tr>`).join('')}</table><h3>جمع کل: ${i.total.toLocaleString('fa-IR')} تومان</h3><script>window.onload=()=>window.print()<\/script></html>`);w.document.close()}
function printLabel(id){let p=products.find(x=>x.id===id);if(!p)return;let w=window.open('','_blank');w.document.write(`<html lang="fa" dir="rtl"><meta charset="utf-8"><style>body{font-family:Tahoma;text-align:center;padding:10px}.label{border:1px solid #000;padding:12px;width:240px}</style><div class="label"><b>${esc(p.name)}</b><p>${p.sell.toLocaleString('fa-IR')} تومان</p><svg id="code"></svg><div>${esc(p.barcode)}</div></div><script>document.getElementById('code').innerHTML='<text x=\"4\" y=\"24\" font-size=\"18\">|||| ||| || |||| | |||</text>';window.onload=()=>window.print()<\/script></html>`);w.document.close()}
function exportData(){let data={app:'Fece-gis',version:2,products,invoices,customers,exportedAt:new Date().toISOString()};let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:'application/json'}));a.download='fece-gis-backup.json';a.click();URL.revokeObjectURL(a.href)}
function importData(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let d=JSON.parse(r.result);if(!Array.isArray(d.products)||!Array.isArray(d.invoices))throw 0;if(confirm('اطلاعات فعلی با پشتیبان جایگزین شود؟')){products=d.products;invoices=d.invoices;customers=Array.isArray(d.customers)?d.customers:[];save();alert('بازیابی انجام شد')}}catch{alert('فایل پشتیبان معتبر نیست')}};r.readAsText(f)}
function setPin(){let p=newPin.value.trim();if(!/^\d{4,8}$/.test(p))return alert('رمز باید ۴ تا ۸ رقم باشد');localStorage.setItem('fg_pin',p);newPin.value='';alert('رمز ذخیره شد؛ قفل ورود در نسخه بعدی تکمیل می‌شود')}
function clearAll(){if(confirm('همه کالاها، فاکتورها و مشتریان برای همیشه پاک شوند؟')){products=[];invoices=[];customers=[];save()}}
notebookPhoto.addEventListener('change',()=>{photoStatus.textContent=notebookPhoto.files[0]?'عکس انتخاب شد: '+notebookPhoto.files[0].name+' — خواندن خودکار دست‌خط هنوز در این نسخه فعال نیست.':''});

// همگام‌سازی ابری با Supabase: محصولات، فاکتورها و مشتریان در یک ردیف اختصاصی هر حساب ذخیره می‌شوند.
let sbClient=null,cloudBusy=false,lastCloudPayload='';
function setCloudStatus(m){const e=document.getElementById('cloudStatus');if(e)e.textContent=m}
function saveCloudSettings(){const url=(sbUrl.value||'').trim().replace(/\/+$/,'');const key=(sbKey.value||'').trim();if(!/^https:\/\/[a-z0-9-]+\.supabase\.co$/i.test(url)||!key)return alert('آدرس پروژه و کلید عمومی Publishable را درست وارد کنید.');localStorage.setItem('fg_sb_url',url);localStorage.setItem('fg_sb_key',key);sbClient=null;initSupabase();setCloudStatus('تنظیمات ذخیره شد. حالا حساب بسازید یا وارد شوید.')}
function initSupabase(){const url=localStorage.getItem('fg_sb_url'),key=localStorage.getItem('fg_sb_key');if(!url||!key||!window.supabase)return null;if(!sbClient)sbClient=window.supabase.createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});return sbClient}
function saveCloudSettingsIfFieldsPresent(){if(sbUrl.value.trim()&&sbKey.value.trim()){localStorage.setItem('fg_sb_url',sbUrl.value.trim().replace(/\/+$/,''));localStorage.setItem('fg_sb_key',sbKey.value.trim());sbClient=null}}
async function cloudSignUp(){saveCloudSettingsIfFieldsPresent();const c=initSupabase(),email=sbEmail.value.trim(),password=sbPassword.value;if(!c)return alert('ابتدا آدرس و کلید عمومی را ذخیره کنید.');if(!email||password.length<6)return alert('ایمیل معتبر و رمز حداقل ۶ نویسه وارد کنید.');setCloudStatus('در حال ساخت حساب...');const {error}=await c.auth.signUp({email,password});if(error){setCloudStatus('خطا در ساخت حساب: '+error.message);return}setCloudStatus('درخواست ساخت حساب ارسال شد. اگر تأیید ایمیل فعال است، ایمیل را تأیید کنید و سپس وارد شوید.')}
async function cloudSignIn(){saveCloudSettingsIfFieldsPresent();const c=initSupabase(),email=sbEmail.value.trim(),password=sbPassword.value;if(!c)return alert('ابتدا آدرس و کلید عمومی را ذخیره کنید.');if(!email||!password)return alert('ایمیل و رمز را وارد کنید.');setCloudStatus('در حال ورود...');const {error}=await c.auth.signInWithPassword({email,password});if(error){setCloudStatus('ورود ناموفق: '+error.message);return}await cloudSyncNow(true)}
async function cloudSignOut(){const c=initSupabase();if(c)await c.auth.signOut();setCloudStatus('از حساب ابری خارج شدید؛ اطلاعات محلی پاک نشده است.')}
async function cloudSyncNow(fromLogin=false){const c=initSupabase();if(!c)return alert('ابتدا تنظیمات Supabase را ذخیره کنید.');if(cloudBusy)return;cloudBusy=true;try{const {data:ad,error:ae}=await c.auth.getUser();if(ae||!ad.user){setCloudStatus('برای همگام‌سازی ابتدا وارد حساب شوید.');return}const userId=ad.user.id;setCloudStatus('در حال همگام‌سازی...');const {data:remote,error}=await c.from('fece_gis_data').select('payload,updated_at').eq('user_id',userId).maybeSingle();if(error){setCloudStatus('خطا در خواندن آنلاین: '+error.message+'؛ جدول و سیاست‌های SQL را بررسی کنید.');return}const local={products,invoices,customers};const hasLocal=products.length||invoices.length||customers.length;if(!remote){const {error:up}=await c.from('fece_gis_data').upsert({user_id:userId,payload:local,updated_at:new Date().toISOString()},{onConflict:'user_id'});if(up){setCloudStatus('خطا در ذخیره آنلاین: '+up.message);return}lastCloudPayload=JSON.stringify(local);setCloudStatus('اطلاعات در فضای ابری ذخیره شد. در دستگاه دیگر با همین حساب وارد شوید.');return}const rp=remote.payload||{};const hasRemote=(rp.products||[]).length||(rp.invoices||[]).length||(rp.customers||[]).length;if(fromLogin&&hasLocal&&hasRemote){const useRemote=confirm('اطلاعات محلی و آنلاین هر دو وجود دارند. OK = اطلاعات آنلاین جایگزین این دستگاه شود؛ Cancel = اطلاعات این دستگاه در فضای آنلاین ذخیره شود.');if(useRemote){products=Array.isArray(rp.products)?rp.products:[];invoices=Array.isArray(rp.invoices)?rp.invoices:[];customers=Array.isArray(rp.customers)?rp.customers:[];persistCloudData()}else{const {error:up}=await c.from('fece_gis_data').upsert({user_id:userId,payload:local,updated_at:new Date().toISOString()},{onConflict:'user_id'});if(up){setCloudStatus('خطا در ذخیره آنلاین: '+up.message);return}}}else if(hasRemote&&!hasLocal){products=Array.isArray(rp.products)?rp.products:[];invoices=Array.isArray(rp.invoices)?rp.invoices:[];customers=Array.isArray(rp.customers)?rp.customers:[];persistCloudData()}else{const lt=Number(localStorage.getItem('fg_local_updated')||0),rt=Date.parse(remote.updated_at||0)||0;if(lt>rt){const {error:up}=await c.from('fece_gis_data').upsert({user_id:userId,payload:local,updated_at:new Date().toISOString()},{onConflict:'user_id'});if(up){setCloudStatus('خطا در ذخیره آنلاین: '+up.message);return}}else if(hasRemote){products=Array.isArray(rp.products)?rp.products:[];invoices=Array.isArray(rp.invoices)?rp.invoices:[];customers=Array.isArray(rp.customers)?rp.customers:[];persistCloudData()}}lastCloudPayload=JSON.stringify({products,invoices,customers});setCloudStatus('همگام‌سازی انجام شد: '+new Date().toLocaleTimeString('fa-IR'))}catch(e){setCloudStatus('خطا در همگام‌سازی: '+(e.message||String(e)))}finally{cloudBusy=false}}
function persistCloudData(){localStorage.setItem('fg_products',JSON.stringify(products));localStorage.setItem('fg_invoices',JSON.stringify(invoices));localStorage.setItem('fg_customers',JSON.stringify(customers));renderAll()}
async function cloudAutoSync(){if(!navigator.onLine||!localStorage.getItem('fg_sb_url'))return;const c=initSupabase();if(!c)return;const {data}=await c.auth.getSession();if(!data.session)return;const now=JSON.stringify({products,invoices,customers});if(now!==lastCloudPayload)await cloudSyncNow(false)}
window.addEventListener('online',()=>setTimeout(cloudAutoSync,900));window.addEventListener('load',()=>{const defaultUrl='https://dkgjkgkakcadzmtslopt.supabase.co';let u=localStorage.getItem('fg_sb_url')||defaultUrl,k=localStorage.getItem('fg_sb_key')||'';localStorage.setItem('fg_sb_url',u);sbUrl.value=u;sbKey.value=k;if(k)initSupabase();setCloudStatus(k?'کلید ذخیره‌شده پیدا شد؛ برای شروع حساب بسازید یا وارد شوید.':'آدرس پروژه آماده است؛ در بخش پشتیبان کلید عمومی Publishable را وارد و ذخیره کنید.')});

renderAll();renderCart();
if('serviceWorker' in navigator)window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}));
</script>
</body></html>